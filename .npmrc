# electron-builder walks node_modules to collect runtime deps. A flat
# (npm-like) layout avoids surprises with pnpm's default symlinked store.
node-linker=hoisted

# TanStack Start + RSC is still experimental, and its peer ranges occasionally
# lag behind the fastest React/Vite releases. Keep installs non-blocking.
auto-install-peers=true
strict-peer-dependencies=false
