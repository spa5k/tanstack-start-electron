{
  "name": "tanstack-start-electron",
  "version": "1.0.0",
  "private": true,
  "description": "TanStack Start (SSR + streaming + RSC) running inside Electron",
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,desktop -c blue,magenta \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "vite dev --port 3000 --strictPort",
    "dev:desktop": "concurrently -k -n electron,app -c yellow,green \"npm:electron:watch\" \"npm:electron:start\"",
    "electron:watch": "tsup --config electron/tsup.config.ts --watch",
    "electron:start": "wait-on build/main.cjs && cross-env NODE_ENV=development nodemon",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "tsup --config electron/tsup.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke": "npm run build && cross-env NODE_ENV=production ELECTRON_SMOKE_TEST=1 electron .",
    "screenshots": "npm run build && electron scripts/screenshots.cjs",
    "start:server": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.52",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3",
    "srvx": "^1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nitro": "^3.0.260903-beta",
    "nodemon": "^3.1.10",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "author": {
    "name": "TanStack Start Electron Guide"
  },
  "license": "Apache-2.0",
  "keywords": [
    "tanstack-start",
    "tanstack-router",
    "electron",
    "rsc",
    "ssr",
    "vite",
    "react",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spa5k/tanstack-start-electron.git"
  },
  "homepage": "https://github.com/spa5k/tanstack-start-electron",
  "bugs": {
    "url": "https://github.com/spa5k/tanstack-start-electron/issues"
  }
}
